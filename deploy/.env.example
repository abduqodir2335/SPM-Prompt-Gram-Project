# =============================================================================
# PromptGram — server configuration template
#
# This file is a TEMPLATE. It is safe to commit because it holds no real values.
# The real file lives ONLY on the server:  ~/promptgram/.env   (mode 600)
#
# How to use it (docs/STUDENT-GUIDE.md, step 0.5):
#   1. Copy this file to the server as ~/promptgram/.env
#   2. Replace every CHANGE_ME with your own value
#   3. chmod 600 ~/promptgram/.env
#
# Rules:
#   - Never commit the real .env. Never paste it into an AI chat, an issue or a PR.
#   - Format is KEY=value. No spaces around "=". No quotes.
#   - If you add a variable here, add it to docs/02-architecture.md section 6 too.
# =============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
# User and database name. You can keep these.
POSTGRES_USER=promptgram
POSTGRES_DB=promptgram

# Database password. Use letters and digits only (it becomes part of a URL).
# Make one with:   openssl rand -hex 24
# IMPORTANT: PostgreSQL reads this value only when it creates the database
# (first deployment). Changing it later here does NOT change the real password.
POSTGRES_PASSWORD=CHANGE_ME

# --- Application --------------------------------------------------------------
# Signs the session cookie and the CSRF token. At least 32 random characters.
# Make one with:   openssl rand -hex 32
# Changing it later logs out every user.
SECRET_KEY=CHANGE_ME

# false while the site uses plain http (the course server). true only with https.
SESSION_COOKIE_SECURE=false

# Largest upload per file, in megabytes.
MAX_UPLOAD_MB=5

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# --- Managed by the pipeline — DO NOT EDIT -----------------------------------
# deploy.sh rewrites these three lines on every deployment.
# Leave them empty when you create the file.
IMAGE_REPO=
IMAGE_TAG=
WEB_PORT=
